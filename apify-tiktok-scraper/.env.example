# ============================================================
# Apify TikTok Search Scraper v2.0 - Environment Configuration
# ============================================================
# 复制此文件为 .env 并填入你的实际值
# cp .env.example .env
# ============================================================

# -------------------------------------------------------
# Apify API Token (必需)
# -------------------------------------------------------
# 获取地址: https://console.apify.com/account/integrations
# 免费配额: $5 注册赠送
APIFY_API_TOKEN=your-apify-api-token-here

# -------------------------------------------------------
# 搜索配置 (可选)
# -------------------------------------------------------
# 搜索关键词 (逗号分隔)
# 示例: kids supplements,vitamins for kids,children health
SEARCH_QUERIES=kids supplements

# 每个搜索词采集的视频数量 (默认 50)
MAX_RESULTS=50

# 代理国家代码 (可选，限制搜索地区)
# 留空 = 不限；可选: US, GB, JP, DE 等
PROXY_COUNTRY_CODE=

# 是否启用字幕转录 (true/false)
DOWNLOAD_SUBTITLES=true

# -------------------------------------------------------
# 输出配置 (可选)
# -------------------------------------------------------
OUTPUT_FORMAT=json
OUTPUT_DIR=./tiktok_data
