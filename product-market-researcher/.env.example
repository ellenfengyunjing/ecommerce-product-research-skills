# ============================================================
# Amazon Product Research Toolkit - 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的实际值
# cp .env.example .env
# ============================================================

# -------------------------------------------------------
# Apify API (必需)
# -------------------------------------------------------
# 获取地址: https://console.apify.com/account/integrations
# 用于: 亚马逊商品采集、TikTok 数据采集、市场数据采集
APIFY_API_TOKEN=your-apify-api-token-here

# 各平台 Actor（按当前 Apify 账号可用 Actor 填写）
APIFY_1688_ACTOR_ID=your-1688-actor-id
APIFY_REDDIT_ACTOR_ID=your-reddit-actor-id
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
APIFY_TIKTOK_SHOP_ACTOR_ID=your-tiktok-shop-actor-id
APIFY_GOOGLE_TRENDS_ACTOR_ID=your-google-trends-actor-id
APIFY_MARKET_REPORT_ACTOR_ID=your-market-report-actor-id

# -------------------------------------------------------
# 数据采集区域 (可选)
# -------------------------------------------------------
# 默认市场: US (美国)
# 可选: US, UK, DE, FR, IT, ES, JP, CA, AU, IN
DEFAULT_MARKET=US

# -------------------------------------------------------
# 输出配置 (可选)
# -------------------------------------------------------
# 报告输出格式: markdown, pdf, word, html
OUTPUT_FORMAT=markdown

# 报告输出目录 (默认: ./output)
OUTPUT_DIR=./output

# -------------------------------------------------------
# 采集参数 (可选)
# -------------------------------------------------------
# 最大采集商品数
MAX_PRODUCTS=100

# 最低有效样本量（用户输入低于下限时自动提升）
MIN_AMAZON_PRODUCTS=50
DEFAULT_TIKTOK_ITEMS=50
MIN_TIKTOK_ITEMS=50
MIN_REDDIT_ITEMS=20
MIN_SUPPLIERS=20

# 最小评论数 (过滤垃圾商品)
MIN_REVIEW_COUNT=50

# 价格区间 (USD)
MIN_PRICE=10
MAX_PRICE=50

# 最低评分
MIN_RATING=4.0

# -------------------------------------------------------
# 代理配置 (可选)
# -------------------------------------------------------
# 是否启用代理 (true/false)
PROXY_ENABLED=false

# 代理格式: http://user:pass@host:port
# PROXY_URL=http://user:pass@host:port

# -------------------------------------------------------
# TikTok 数据 (可选)
# -------------------------------------------------------
# TikTok 标签列表 (逗号分隔)
# TIKTOK_HASHTAGS=kidssupplements,childhealth,gummyvitamins

# Google Trends：保存最近 6 个月数据与截图
TRENDS_MONTHS=6
TRENDS_SAVE_SCREENSHOT=true

# -------------------------------------------------------
# 高级配置 (可选)
# -------------------------------------------------------
# 并发采集线程数
CONCURRENCY=3

# 请求间隔 (秒)
REQUEST_DELAY=2

# 是否保存原始数据
SAVE_RAW_DATA=true

# -------------------------------------------------------
# 开发配置 (可选)
# -------------------------------------------------------
# DEBUG 模式
DEBUG=false

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
